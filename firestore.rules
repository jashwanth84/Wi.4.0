rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { return isSignedIn() && (request.auth.token.email == 'malleshr20944@gmail.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }
    
    // Schema validaton for User
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'walletBalance', 'bonusBalance', 'role', 'createdAt'])
        && data.userId == request.auth.uid
        && data.walletBalance is number
        && data.bonusBalance is number
        && data.role == 'user'
        && data.createdAt == request.time;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn(); // Allow reading metadata for leaderboard/participants
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      // Anyone signed in can view tournaments
      allow read: if isSignedIn() || true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin(); // Allow admins to delete directly

      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (request.auth.uid == participantId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /wallet_transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /deposit_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().amount is number && incoming().amount > 0;
      allow update: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sliders/{sliderId} {
      allow read: if isSignedIn() || true; // Public or auth users
      allow write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /app_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
